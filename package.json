{
  "name": "exchange-backend",
  "description": "Backend application for Exchange project",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nodemon",
    "lint": "eslint",
    "local": "npm run build && cross-env ENV_SOURCE=file MODE=local NODE_ENV=production USE_HTTPS=true node ./build/index.js",
    "start": "npm run build && cross-env ENV_SOURCE=nofile MODE=public NODE_ENV=production USE_HTTPS=false node ./build/index.js"
  },
  "author": {
    "name": "Peter Dyumin",
    "url": "https://github.com/peterdee"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterdee/exchange-backend"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.5.0",
    "ip": "^2.0.1",
    "qrcode-terminal": "^0.12.0",
    "scryptwrap": "^2.0.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/ip": "^1.1.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.46.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.0",
    "nodemon": "^3.0.1"
  }
}
